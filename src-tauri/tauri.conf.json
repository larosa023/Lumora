{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumora",
  "version": "0.7.4",
  "identifier": "app.lumora.rgb",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumora",
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#0b0b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg"
    ],
    "publisher": "Lumora",
    "category": "Utility",
    "shortDescription": "One lightweight app for all your RGB",
    "longDescription": "Lumora controls the RGB lighting on your RAM, motherboard, GPU, coolers, fans, keyboards, mice and more from one clean, lightweight app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQjk2MTQ4MEZDMTRFRUQKUldUdFRzRVBTR0c1cllTZ3k2NGRwWFZxRXkvNUV1N1JOb2czZXQ5S1U5Qzl0OXBuQm5HbkYydlEK",
      "endpoints": [
        "https://github.com/larosa023/lumora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
